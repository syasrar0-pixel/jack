    \f1\ltrch\lang1033 let sl = parseFloat(document.getElementById('slInput').value || 0)\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 if (tp > 0 && currentProfit >= tp) finish\f0\rtlch\lang1025 ("\f2\ltrch\lang1033\u-10180?\u-8273?\f3  \f4\rtlch\lang1025\'e3\'c8\'d1\'e6\'df! \'ca\'e3 \'ca\'cd\'de\'ed\'de \'e5\'cf\'dd \'c7\'e1\'d1\'c8\'cd \'c7\'e1\'ed\'e6\'e3\'ed.");\f0\par
    \f1\ltrch\lang1033 else if (sl > 0 && currentProfit <= -sl) finish\f0\rtlch\lang1025 ("\f2\ltrch\lang1033\u-10179?\u-8495?\f0\rtlch\lang1025  \f4\'ca\'e4\'c8\'ed\'e5: \'ca\'e3 \'c7\'e1\'e6\'d5\'e6\'e1 \'e1\'cd\'cf \'c7\'e1\'ce\'d3\'c7\'d1\'c9 \'c7\'e1\'e3\'d3\'e3\'e6\'cd \'c8\'e5.");\f0\par
\}\par
\par
