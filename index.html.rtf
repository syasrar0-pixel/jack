<\f1\ltrch\lang1033 script\f0\rtlch\lang1025 >\par
\f1\ltrch\lang1033 let balance, nextValue, startBalance, wins = 0, losses = 0\f0\rtlch\lang1025 ;\par
\par
\f1\ltrch\lang1033 function resetAll\f0\rtlch\lang1025 () \{\par
    \f1\ltrch\lang1033 startBalance = parseFloat(document.getElementById('capitalInput').value) || 100\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 balance = startBalance\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 nextValue = parseFloat(document.getElementById('baseInput').value) || 2\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 wins = 0; losses = 0\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById('rowsBody').innerHTML\f0\rtlch\lang1025  = "";\par
    \f1\ltrch\lang1033 document.getElementById('lossBtn').disabled = false\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById('winBtn').disabled = false\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById('stopMessage').style.display = "none\f0\rtlch\lang1025 ";\par
    \f1\ltrch\lang1033 updateUI\f0\rtlch\lang1025 ();\par
\}\par
\par
\f1\ltrch\lang1033 function executeTrade(result)\f0\rtlch\lang1025  \{\par
    \f1\ltrch\lang1033 let amount = nextValue\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 let payout = (parseFloat(document.getElementById('payoutInput').value) || 82) / 100\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 let net = 0\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 let time = new Date().toLocaleTimeString('ar-EG', \{ hour12: false \})\f0\rtlch\lang1025 ;\par
\par
    \f1\ltrch\lang1033 if (result === 'loss')\f0\rtlch\lang1025  \{\par
        \f1\ltrch\lang1033 net = -amount; balance += net\f0\rtlch\lang1025 ;\par
        \f1\ltrch\lang1033 nextValue *= (parseFloat(document.getElementById('multInput').value) || 2.2)\f0\rtlch\lang1025 ;\par
        \f1\ltrch\lang1033 losses\f0\rtlch\lang1025 ++;\par
    \} \f1\ltrch\lang1033 else\f0\rtlch\lang1025  \{\par
        \f1\ltrch\lang1033 net = amount * payout; balance += net\f0\rtlch\lang1025 ;\par
        \f1\ltrch\lang1033 nextValue = parseFloat(document.getElementById('baseInput').value) || 2\f0\rtlch\lang1025 ;\par
        \f1\ltrch\lang1033 wins\f0\rtlch\lang1025 ++;\par
    \}\par
\par
    \f1\ltrch\lang1033 const rowHTML = `<tr><td>$\{wins+losses\}</td><td>$\{time\}</td><td class="$\{result\}\f0\rtlch\lang1025 ">$\{\f1\ltrch\lang1033 result==='win\f0\rtlch\lang1025 '?'\f4\'d1\'c8\'cd':'\'ce\'d3\'c7\'d1\'c9'\f0\}</\f1\ltrch\lang1033 td><td>$\{amount.toFixed\f0\rtlch\lang1025 (\f1\ltrch\lang1033 2\f0\rtlch\lang1025 )\f1\ltrch\lang1033\}$</td><td class="$\{result\}">$\{net>0?'+':''\}$\{net.toFixed\f0\rtlch\lang1025 (\f1\ltrch\lang1033 2\f0\rtlch\lang1025 )\f1\ltrch\lang1033\}$</td><td>$\{balance.toFixed\f0\rtlch\lang1025 (\f1\ltrch\lang1033 2\f0\rtlch\lang1025 )\f1\ltrch\lang1033\}$</td></tr\f0\rtlch\lang1025 >`;\par
    \f1\ltrch\lang1033 document.getElementById('rowsBody').insertAdjacentHTML('afterbegin', rowHTML)\f0\rtlch\lang1025 ; // \f4\'c7\'e1\'c5\'d6\'c7\'dd\'c9 \'dd\'ed \'c7\'e1\'c3\'da\'e1\'ec\f0\par
    \f1\ltrch\lang1033 updateUI\f0\rtlch\lang1025 ();\par
    \f1\ltrch\lang1033 checkLimits\f0\rtlch\lang1025 ();\par
\}\par
\par
\f1\ltrch\lang1033 function updateUI\f0\rtlch\lang1025 () \{\par
    \f1\ltrch\lang1033 document.getElementById('balanceLabel').innerText\f0\rtlch\lang1025  = `\f4\'c7\'e1\'d1\'d5\'ed\'cf: $\f0\{\f1\ltrch\lang1033 balance.toFixed\f0\rtlch\lang1025 (\f1\ltrch\lang1033 2\f0\rtlch\lang1025 )\}$`;\par
    \f1\ltrch\lang1033 document.getElementById('nextTradeLabel').innerText\f0\rtlch\lang1025  = `\f4\'c7\'e1\'d5\'dd\'de\'c9 \'c7\'e1\'de\'c7\'cf\'e3\'c9: $\f0\{\f1\ltrch\lang1033 nextValue.toFixed\f0\rtlch\lang1025 (\f1\ltrch\lang1033 2\f0\rtlch\lang1025 )\}$`;\par
    \par
    \f1\ltrch\lang1033 let total = wins + losses\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 let totalProfit = balance - startBalance\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById("statProfit").innerText = totalProfit.toFixed\f0\rtlch\lang1025 (\f1\ltrch\lang1033 2\f0\rtlch\lang1025 ) + "$";\par
    \f1\ltrch\lang1033 document.getElementById("statTotal").innerText = total\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById("statWins").innerText = wins\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById("statLosses").innerText = losses\f0\rtlch\lang1025 ;\par
    \f1\ltrch\lang1033 document.getElementById("statRate").innerText = (total ? ((wins / total) * 100).toFixed(1) : 0)\f0\rtlch\lang1025  + "%";\par
\}\par
\par
\f1\ltrch\lang1033 function checkLimits\f0\rtlch\lang1025 () \{\par
    \f1\ltrch\lang1033 let currentProfit = balance - startBalance\f0\rtlch\lang1025 ;\par
